# Supabase (finance-calc project)
# Copy to .env.local and fill from Dashboard → Project Settings → API
# or: supabase projects api-keys --project-ref <ref>

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site origin used for magic-link emailRedirectTo (/auth/confirm).
# Primary auth is in-app 6-digit OTP; magic link is secondary.
# Required in production; local default falls back to request Host / localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the browser / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel AI Gateway (photo vision extract). OIDC on Vercel, or API key locally.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# Optional: override default vision model (issue #10 / #27)
# VISION_MODEL=google/gemini-2.5-flash-lite

# Optional: override default STT model (issue #9 / #28)
# STT_MODEL=openai/gpt-4o-mini-transcribe

# Optional: override post-STT text extract model (issue #28)
# TEXT_EXTRACT_MODEL=google/gemini-2.5-flash-lite

# Honeybadger error tracking (https://docs.honeybadger.io/lib/javascript/integration/nextjs/)
# Project API key (public client token — safe as NEXT_PUBLIC_*)
NEXT_PUBLIC_HONEYBADGER_API_KEY=your-honeybadger-project-token
# Optional deploy revision; on Vercel falls back to VERCEL_GIT_COMMIT_SHA
# NEXT_PUBLIC_HONEYBADGER_REVISION=

# Optional: direct DB (migrations / admin scripts)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Auth (Dashboard) — Authentication → URL Configuration:
# - Site URL: same as NEXT_PUBLIC_SITE_URL (e.g. http://localhost:3000)
# - Redirect URLs allow list (include all you use):
#     http://localhost:3000/**
#     http://localhost:3000/auth/confirm
#     https://YOUR_PRODUCTION_DOMAIN/**
#     https://YOUR_PRODUCTION_DOMAIN/auth/confirm
# - Email provider on; template should show {{ .Token }} (6-digit OTP) for PWA
# - Magic link ConfirmationURL can remain as secondary (opens /auth/confirm)
# - Single-user: pre-create the user; app uses shouldCreateUser: false
# - Seed Categories: AFTER INSERT on auth.users (schema ticket #22)
#
# Primary flow: /login → email → 6-digit code in app → cookie session → /
# Secondary: email link → /auth/confirm?code=… (same browser as login start)
