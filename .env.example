# Supabase (finance-calc project)
# Copy to .env.local and fill from Dashboard → Project Settings → API
# or: supabase projects api-keys --project-ref <ref>

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional public site origin (redirects / email links)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — never expose to the browser / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct DB (migrations / admin scripts)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Auth (Dashboard) for this ticket:
# - Email provider on; Magic Link template includes {{ .Token }} (OTP primary)
# - Optional secondary link: {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email
# - Redirect allow list: http://localhost:3000/** and production /auth/confirm
# - Single-user: pre-create the user; app uses shouldCreateUser: false
# - Seed Categories: AFTER INSERT on auth.users (schema ticket #22)
